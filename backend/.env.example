# ==========================================
# HackMate - Backend Environment Variables
# ==========================================

# Database Connection (PostgreSQL for production, SQLite for local dev)
# Example for PostgreSQL: postgresql://username:password@hostname:5432/hackmate
DATABASE_URL=postgresql://user:password@localhost:5432/hackmatedb

# JWT Secret Key (Generate with: openssl rand -hex 32)
SECRET_KEY=your-production-secret-key-min-32-chars-long

# JWT Algorithm
ALGORITHM=HS256

# Access token expiry (in minutes) - 10080 = 7 days
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS Allowed Origins (Comma-separated list of allowed frontend domains)
# Example: https://hackmate.vercel.app,https://yourdomain.com
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Public URL of the Frontend application
FRONTEND_URL=http://localhost:3000

# Public URL of the Backend API
BACKEND_URL=http://localhost:8000
